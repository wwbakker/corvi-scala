package build

import mill.*, scalalib.*

/** OpenJFX publishes its real jars — classes and natives — under a per-platform classifier; the bare artifact is an empty 302-byte stub.
  */
val javafxClassifier: String =
  val os = sys.props("os.name").toLowerCase
  val arch = sys.props("os.arch").toLowerCase
  if os.contains("mac") && (arch.contains("aarch64") || arch.contains("arm64")) then "mac-aarch64"
  else if os.contains("mac") then "mac"
  else if os.contains("win") then "win"
  else if arch.contains("aarch64") then "linux-aarch64"
  else "linux"

val javafxVersion: String = "26"

/** Mill parses one exclusion per `;exclude=` segment; a comma-separated list is silently read as a single bogus exclusion, so each one
  * needs its own segment.
  */
val noTransitiveOpenJfx: String = "exclude=org.openjfx:*"

/** Scala 3.10's stdlib lives in `scala-library`, which Mill adds as a mandatory dep; the transitive `scala3-library_3:3.3.8` is a stale
  * duplicate of it on the run classpath.
  */
val noTransitiveScala3Library: String = "exclude=org.scala-lang:scala3-library_3"

object app extends ScalaModule:
  def scalaVersion = "3.10.0"
  def mainClass = Some("corvi.Main")

  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement"
  )

  def mvnDeps = Task {
    Seq(
      mvn"org.scalafx::scalafx:26.0.0-R38;$noTransitiveOpenJfx;$noTransitiveScala3Library",
      mvn"com.softwaremill.ox::core:1.0.9;$noTransitiveScala3Library",
      mvn"ch.qos.logback:logback-classic:1.6.5",
      mvn"com.techsenger.jeditermfx:jeditermfx-core:1.1.0;$noTransitiveOpenJfx",
      mvn"com.techsenger.jeditermfx:jeditermfx-ui:1.1.0;$noTransitiveOpenJfx",
      mvn"org.jetbrains.pty4j:pty4j:0.14.0"
    ) ++ Seq("base", "graphics", "controls", "media")
      // The classifier jar replaces the stub for the module itself; the exclusion drops the bare
      // stubs each OpenJFX POM repeats for its siblings.
      .map(m => mvn"org.openjfx:javafx-$m:$javafxVersion;classifier=$javafxClassifier;$noTransitiveOpenJfx")
  }

  /** ScalaFX's own signatures mention JavaFX modules this app never calls — `javafx.scene.web` and `javafx.embed.swing` — and the compiler
    * needs their jars to read those signatures. They stay compile-only; javafx-web alone is 36 MB of natives.
    *
    * `javafx.media` cannot be compile-only: applying an implicit conversion brings `scalafx.Includes` into the running program, and
    * `Includes` resolves `javafx.scene.media.MediaException` (the stylesheet assignment in `AppWindow.scala` is the first conversion the
    * app applies). An unused import alone loads nothing. Without the module the app dies at startup with
    * `NoClassDefFoundError: javafx/scene/media/MediaException$Type`.
    */
  def compileMvnDeps = Task {
    Seq("web", "swing")
      .map(m => mvn"org.openjfx:javafx-$m:$javafxVersion;classifier=$javafxClassifier;$noTransitiveOpenJfx")
  }

/** The DTOs the host and the future UI share. Pure data: no JavaFX, no Kyo, no terminal engine. */
object contract extends ScalaModule:
  def scalaVersion = "3.10.0"
  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    // The DTOs are compared as whole values (a row against the row it was), so they say so explicitly.
    "-language:strictEquality",
    // A match over one of these enums has to be exhaustive: a new case must break the build, not throw inside a callback.
    "-Wconf:msg=match may not be exhaustive:e"
  )

/** The headless terminal host: PTYs and the VT emulator, no JavaFX. Kyo owns its concurrency. It depends on `protocol` for the routes it
  * answers: the client half of the protocol does not depend on this module, so a UI build does not pull pty4j or jeditermfx in.
  */
object host extends ScalaModule:
  def scalaVersion = "3.10.0"
  def moduleDeps = Seq(contract, protocol)
  def mainClass = Some("corvi.host.HostProbe")

  // Kyo requires these: it returns values that must not be silently discarded, and it relies on
  // strict equality. `kyo-jsonrpc` and `kyo-system` arrive with the protocol phase, when they are used.
  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    // `-Wconf` filters are one option, first match wins: Kyo's macro expansion carries `@nowarn` annotations that no
    // longer suppress anything, and `-Wunused:all` reports each of them. They are generated code, not ours.
    "-Wconf:msg=@nowarn annotation does not suppress any warnings:s," +
      "msg=unused:e," +
      "msg=(discarded.*value|pure.*statement):error," +
      // As above: an enum from the engine gaining a case has to fail the build here, not crash a live session.
      "msg=match may not be exhaustive:e",
    "-language:strictEquality",
    // Kyo's `A < S` values are inline-heavy: a probe with a dozen nested for-comprehensions needs more inlining fuel
    // than the compiler's default budget.
    "-Xmax-inlines:128"
  )

  // The reader fiber parks in a blocking PTY read on purpose (there is no non-blocking read for a pty without a
  // selector pump, which would put a second thread between the bytes and the parser). Kyo's scheduler parks a
  // virtual thread for it and its BlockingMonitor compensates by not counting it as busy - hence both flags.
  def forkArgs = Seq(
    "-Dkyo.scheduler.virtualizeWorkers=true",
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
  )

  def mvnDeps = Task {
    Seq(
      mvn"io.getkyo::kyo-core:1.0.0-RC7",
      mvn"com.techsenger.jeditermfx:jeditermfx-core:1.1.0",
      mvn"org.jetbrains.pty4j:pty4j:0.14.0"
    )
  }

/** The wire and the client half of it: typed `kyo-jsonrpc` routes, schemas, typed errors, and `TerminalService` over a peer handler. It
  * depends on `contract` and nothing else of ours, so the renderer and the UI can take it without pulling the terminal engine in.
  */
object protocol extends ScalaModule:
  def scalaVersion = "3.10.0"
  def moduleDeps = Seq(contract)

  // The same Kyo flags as the host: `A < S` values are inline-heavy, and the engine's enums must stay exhaustively matched.
  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    // The same promotions the host uses: an unused import is an error here too, which is how the two unused ones this module
    // shipped with would have been caught.
    "-Wconf:msg=@nowarn annotation does not suppress any warnings:s," +
      "msg=unused:e," +
      "msg=(discarded.*value|pure.*statement):error," +
      "msg=match may not be exhaustive:e",
    "-language:strictEquality",
    "-Xmax-inlines:128"
  )

  def mvnDeps = Task {
    Seq(
      mvn"io.getkyo::kyo-jsonrpc:1.0.0-RC7"
    )
  }

/** The thin renderer: a `Frame` to pixels, and nothing else. No terminal engine, no PTY, no host — a renderer that parsed bytes would be
  * the thing this rewrite is replacing.
  */
object renderer extends ScalaModule:
  def scalaVersion = "3.10.0"
  def moduleDeps = Seq(contract, protocol)

  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wconf:msg=@nowarn annotation does not suppress any warnings:s," +
      "msg=unused:e," +
      "msg=(discarded.*value|pure.*statement):error," +
      "msg=match may not be exhaustive:e",
    "-language:strictEquality",
    "-Xmax-inlines:128"
  )

  def mvnDeps = Task {
    Seq(
      mvn"org.scalafx::scalafx:26.0.0-R38;$noTransitiveOpenJfx;$noTransitiveScala3Library"
    ) ++ Seq("base", "graphics", "controls", "media")
      .map(m => mvn"org.openjfx:javafx-$m:$javafxVersion;classifier=$javafxClassifier;$noTransitiveOpenJfx")
  }

  /** ScalaFX's signatures mention the web and swing modules even where the app never calls them; the compiler needs their jars to read
    * those signatures, and they stay off the runtime classpath.
    */
  def compileMvnDeps = Task {
    Seq("web", "swing")
      .map(m => mvn"org.openjfx:javafx-$m:$javafxVersion;classifier=$javafxClassifier;$noTransitiveOpenJfx")
  }

  // The client's Kyo runtime lives on its own thread and parks in a blocking queue take, so it wants the same scheduler flags as the host.
  def forkArgs = Seq(
    "-Dkyo.scheduler.virtualizeWorkers=true",
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
  )

/** The window, the snapshot harness and the probe: they start a real host, which is the dependency the `renderer` module must not have. */
object rendererApp extends ScalaModule:
  def scalaVersion = "3.10.0"
  def moduleDeps = Seq(renderer, host, ui)
  def mainClass = Some("corvi.renderer.RendererApp")

  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wconf:msg=@nowarn annotation does not suppress any warnings:s," +
      "msg=unused:e," +
      "msg=(discarded.*value|pure.*statement):error," +
      "msg=match may not be exhaustive:e",
    "-language:strictEquality",
    "-Xmax-inlines:128"
  )

  def forkArgs = Seq(
    "-Dkyo.scheduler.virtualizeWorkers=true",
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
  )

/** The Corvi shell: sidebar, tab strip, Overview and the terminal area, over plain interfaces from `contract`. It depends on nothing of ours
  * but `contract`, so it can be run against a fake view factory and knows nothing about Kyo, the host or the renderer internals.
  */
object ui extends ScalaModule:
  def scalaVersion = "3.10.0"
  def moduleDeps = Seq(contract)

  def scalacOptions = Seq(
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wconf:msg=@nowarn annotation does not suppress any warnings:s," +
      "msg=unused:e," +
      "msg=(discarded.*value|pure.*statement):error," +
      "msg=match may not be exhaustive:e",
    "-language:strictEquality",
    "-Xmax-inlines:128"
  )

  def mvnDeps = Task {
    Seq(
      mvn"org.scalafx::scalafx:26.0.0-R38;$noTransitiveOpenJfx;$noTransitiveScala3Library"
    // `media` is not a compile-only dependency: ScalaFX's `Includes` resolves `javafx.scene.media.MediaException` the first time
    // an implicit conversion is applied, so the module has to be on the runtime classpath of any ScalaFX window.
    ) ++ Seq("base", "graphics", "controls", "media")
      .map(m => mvn"org.openjfx:javafx-$m:$javafxVersion;classifier=$javafxClassifier;$noTransitiveOpenJfx")
  }

  def compileMvnDeps = Task {
    Seq("web", "swing")
      .map(m => mvn"org.openjfx:javafx-$m:$javafxVersion;classifier=$javafxClassifier;$noTransitiveOpenJfx")
  }
